---
import Layout from '../layouts/Layout.astro';
---

<Layout title="حساب کاربری نمایشی | آویژه" desc="بخش حساب کاربری در نمونه‌کار آویژه." page="account.html">
  <div class="container">
    <nav class="breadcrumb"><a href="index.html">خانه</a><span class="sep">›</span><span class="cur">حساب کاربری</span></nav>
    <section class="section" style="max-width:760px;margin-inline:auto">
      <div class="ck-panel" style="text-align:center;padding:clamp(28px,5vw,56px)">
        <h1 style="font-size:clamp(22px,3vw,30px);margin-bottom:14px">حساب کاربری در نسخه آزمایشی</h1>
        <p style="line-height:2;color:var(--ink-soft);max-width:560px;margin:0 auto 22px">
          ورود، ثبت‌نام، مدیریت پروفایل و ذخیره آدرس‌ها در این نسخه غیرفعال است. برای نمایش امکانات، از بخش فروشگاه، فیلترها، جزئیات محصول و سبد نمایشی استفاده کنید.
        </p>
        <a class="btn btn-primary btn-lg" href="shop.html">مشاهده فروشگاه نمایشی</a>
      </div>
    </section>
  </div>
</Layout>
