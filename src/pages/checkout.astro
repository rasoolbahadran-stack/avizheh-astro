---
import Layout from '../layouts/Layout.astro';
---

<Layout title="نمایش فرایند سفارش | آویژه" desc="صفحه نمایشی فرایند خرید در نمونه‌کار آویژه." page="checkout.html">
  <div class="container">
    <nav class="breadcrumb"><a href="index.html">خانه</a><span class="sep">›</span><span class="cur">فرایند سفارش</span></nav>
    <section class="section" style="max-width:760px;margin-inline:auto">
      <div class="ck-panel" style="text-align:center;padding:clamp(28px,5vw,56px)">
        <div style="font-size:42px;margin-bottom:16px">◇</div>
        <h1 style="font-size:clamp(22px,3vw,30px);margin-bottom:14px">این مرحله فقط نمایشی است</h1>
        <p style="line-height:2;color:var(--ink-soft);max-width:560px;margin:0 auto 22px">
          این پروژه برای نمایش طراحی و امکانات رابط کاربری ساخته شده است. پرداخت، دریافت اطلاعات مشتری و ثبت سفارش واقعی در این نسخه فعال نیست.
        </p>
        <a class="btn btn-primary btn-lg" href="shop.html">بازگشت به فروشگاه نمایشی</a>
      </div>
    </section>
  </div>
</Layout>
