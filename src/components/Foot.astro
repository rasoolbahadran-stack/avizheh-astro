---
import { AVZ, icon } from '../data/catalog.js';
const CATS = AVZ.CATS;
const c1 = CATS.slice(0, 4);
const c2 = CATS.slice(4);
---
<footer class="footer">
  <div class="container footer-top">
    <div class="fcol f-about">
      <a class="logo" href="/index.html">
        <svg class="logo-mark" viewBox="0 0 48 48" aria-hidden="true"><defs><linearGradient id="lgA4" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#8E3B5F"></stop><stop offset="1" stop-color="#C0735A"></stop></linearGradient></defs><circle cx="24" cy="24" r="22" fill="none" stroke="url(#lgA4)" stroke-width="2.4"></circle><path d="M24 10c5.2 3.4 8.4 8.6 8.4 14.2 0 6.4-3.9 10.6-8.4 13.8-4.5-3.2-8.4-7.4-8.4-13.8C15.6 18.6 18.8 13.4 24 10z" fill="url(#lgA4)" opacity=".92"></path><path d="M24 15.5c2.9 2.2 4.7 5.3 4.7 8.7 0 3.9-2.2 6.6-4.7 8.6-2.5-2-4.7-4.7-4.7-8.6 0-3.4 1.8-6.5 4.7-8.7z" fill="#FBF7F4" opacity=".9"></path></svg>
        <span class="logo-text"><span class="logo-name">آویژه</span><span class="logo-en">AVIZHEH</span></span>
      </a>
      <p style="margin-top:14px">آویژه، مرجع تخصصی پوشاک، لباس زیر و لباس راحتی؛ با انتخابی دقیق از محصولات باکیفیت، سایزبندی دقیق و تجربه‌ی خریدی که آرامش‌بخش است — نه پرتنش.</p>
      <div class="f-socials">
        <a href="#" aria-label="اینستاگرام" onclick="return false"><Fragment set:html={icon('instagram')} /></a>
        <a href="#" aria-label="تلگرام" onclick="return false"><Fragment set:html={icon('send')} /></a>
        <a href="#" aria-label="واتساپ" onclick="return false"><Fragment set:html={icon('phone')} /></a>
      </div>
    </div>
    <div class="fcol"><h4>دسته‌بندی‌ها</h4><ul>{c1.map((c) => <li><a href={'/shop.html?cat=' + c.slug}>{c.name}</a></li>)}</ul></div>
    <div class="fcol"><h4>دسته‌بندی‌ها</h4>
      <ul>{c2.map((c) => <li><a href={'/shop.html?cat=' + c.slug}>{c.name}</a></li>)}</ul>
      <h4 style="margin-top:20px">خدمات مشتریان</h4>
      <ul>
        <li><a href="/faq.html">سؤالات متداول</a></li>
        <li><a href="/shipping.html">شرایط ارسال</a></li>
        <li><a href="/returns.html">مرجوعی و تعویض</a></li>
        <li><a href="/size-guide.html">راهنمای سایز</a></li>
      </ul>
    </div>
    <div class="fcol"><h4>اطلاعات تماس</h4>
      <ul class="f-contact">
        <li><Fragment set:html={icon('pin')} /><span>تهران، خیابان ولیعصر، نرسیده به پارک‌وی، پلاک ۲۱۰، طبقه ۳</span></li>
        <li><Fragment set:html={icon('phone')} /><span>۰۲۱-۹۱۰۰۰۲۰۰ | پشتیبانی هر روز ۹ تا ۲۱</span></li>
        <li><Fragment set:html={icon('mail')} /><span>support@avizheh.ir</span></li>
      </ul>
      <div class="f-trust">
        <span class="trust-badge"><Fragment set:html={icon('shield')} />نماد اعتماد (نمایشی)</span>
        <span class="trust-badge"><Fragment set:html={icon('card')} />پرداخت امن (نمایشی)</span>
      </div>
    </div>
  </div>
  <div class="footer-bar">
    <div class="container">
      <span>© ۱۴۰۵ فروشگاه آویژه — تمام حقوق محفوظ است. این سایت یک نمونه‌کار نمایشی است.</span>
      <span class="credit"><Fragment set:html={icon('heart')} />طراحی و توسعه توسط <a href="https://cdanesh.ir/" target="_blank" rel="noopener">کافه دانش</a></span>
    </div>
  </div>
</footer>
